# HomeFix — biến môi trường (SPEC 8.1). Chép thành .env rồi sửa. KHÔNG commit .env.

# Máy chủ thật: bỏ dấu # ở dòng sau để Docker Compose KHÔNG nạp docker-compose.override.yml (cấu hình dev).
# COMPOSE_FILE=docker-compose.yml

# Khóa bí mật Django — sinh bằng: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=doi-gia-tri-nay
# 0 trên máy chủ thật
DJANGO_DEBUG=0
# Tên miền truy cập, cách nhau dấu phẩy. Ví dụ Tailscale: homefix.ten-tailnet.ts.net
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Gốc HTTPS được tin cậy cho CSRF, ví dụ https://homefix.ten-tailnet.ts.net
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# 1 = cookie chỉ gửi qua HTTPS (bắt buộc khi đưa ra Internet); 0 khi thử trong mạng nội bộ bằng http
DJANGO_COOKIE_SECURE=1
# Địa chỉ đầy đủ của trang, dùng trong liên kết thông báo
SITE_URL=http://localhost:8000

# CSDL PostgreSQL (container db). Docker Compose tự ghép DATABASE_URL từ ba biến này.
POSTGRES_DB=homefix
POSTGRES_USER=homefix
POSTGRES_PASSWORD=doi-mat-khau-csdl
# Chỉ cần khi chạy Django ngoài Docker (vd. pytest trên máy dev): CSDL dev mở ở cổng 5433
# DATABASE_URL=postgres://homefix:doi-mat-khau-csdl@localhost:5433/homefix

# Web Push — sinh bằng: make vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Email liên hệ gửi kèm Web Push, dạng mailto:ban@vidu.vn
VAPID_EMAIL=

# Telegram Bot (tùy chọn, kênh dự phòng)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Chuỗi bí mật ngẫu nhiên cho URL webhook Telegram; để trống nếu dùng lệnh `python manage.py telegram_poll`
TELEGRAM_WEBHOOK_SECRET=
# 1 = chỉ in thông báo ra log (phát triển); 0 = gửi Web Push/Telegram thật
THONG_BAO_CHI_CONSOLE=0

# Số ngày giữ bản sao lưu
BACKUP_KEEP_DAYS=14
